# Void Mobile — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário.
# NUNCA commite o arquivo .env com valores reais de produção.

# URL da API REST (com /api no final)
EXPO_PUBLIC_API_URL=

# URL do servidor Socket.IO (sem /api)
EXPO_PUBLIC_SOCKET_URL=

# true  → usa as URLs acima diretamente (ignora detecção local)
# false → usa a detecção automática de ambiente local
EXPO_PUBLIC_FORCE_PROD=